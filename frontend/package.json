{
  "name": "imagehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "go": "concurrently -n web,api,thumbs \"npm run dev\" \"npm run start:backend:spring\" \"npm run start:thumbnailer\"",
    "start:backend": "npm run start:backend:spring",
    "start:backend:spring": "node scripts/start-spring.mjs",
    "start:thumbnailer": "node scripts/start-thumbnailer.mjs",
    "start:backend:dotnet": "cd ../backend/imagehubapi && dotnet run",
    "create:backend:dotnet": "cd ../backend/imagehubapi && dotnet ef migrations add InitialCreate && dotnet ef database update"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "concurrently": "^9.1.2",
    "material-symbols": "^0.35.2",
    "next": "^15.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "sass": "^1.83.4",
    "typescript": "^5"
  }
}
